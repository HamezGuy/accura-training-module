{
  "name": "accura-training-module",
  "version": "1.0.0",
  "description": "21 CFR Part 11 compliant training module backend for AccuraTrial EDC — course management, quiz grading, compliance tracking, and certificate generation",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand --verbose",
    "test:unit": "jest tests/unit --runInBand --verbose",
    "test:integration": "jest tests/integration --runInBand --verbose --testTimeout=60000",
    "seed": "ts-node seed/run-seed.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "edc",
    "clinical-trials",
    "training",
    "21-cfr-part-11",
    "compliance"
  ],
  "author": "AccuraTrial",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "uuid": "^11.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
