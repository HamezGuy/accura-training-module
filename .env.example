# AccuraTrial Training Module - Environment Configuration
# 
# PRODUCTION: All DB/JWT values are injected via Docker env vars from
# the main libreclinica_api container. Never hardcode production credentials.
#
# LOCAL DEV: Copy to .env and fill in values matching your local docker setup.
# NEVER commit .env to git.

# Server
PORT=3002
NODE_ENV=development

# Database — MUST match the main API's database in production
# In production, these are pulled from libreclinica_api container automatically
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=libreclinica
DATABASE_USER=libreclinica
DATABASE_PASSWORD=libreclinica
DATABASE_SSL=false

# JWT — MUST match libreclinica_api JWT_SECRET exactly
# In production, pulled from libreclinica_api container automatically
JWT_SECRET=your-jwt-secret-must-match-main-api

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info

# Training Configuration
CERTIFICATE_VALIDITY_DAYS=365
EXPIRATION_CHECK_CRON=0 2 * * *
