# AccuraTrial Training Module - Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3002
NODE_ENV=development

# Database (same PostgreSQL as libreclinicaapi)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libreclinica
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=libreclinica
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# JWT (MUST match libreclinicaapi JWT_SECRET)
JWT_SECRET=your-jwt-secret-must-match-main-api

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info

# Training Configuration
CERTIFICATE_VALIDITY_DAYS=365
EXPIRATION_CHECK_CRON=0 2 * * *
