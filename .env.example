# AccuraTrial Training Module - Environment Configuration
# 
# PRODUCTION: Database values are configured by the production compose file.
# Never hardcode production credentials or supply the native API signing secret.
#
# LOCAL DEV: Copy to .env and fill in values matching your local docker setup.
# NEVER commit .env to git.

# Server
PORT=3002
NODE_ENV=development

# Training-owned database. An existing shared database remains compatible;
# a dedicated database must retain the same course/record/audit IDs and sequences.
# Identity, organization and study membership are read through ACCURA_API_URL.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=libreclinica
DATABASE_USER=libreclinica
DATABASE_PASSWORD=libreclinica
DATABASE_SSL=false

# Native authority root URL, required in every environment; no local-only fallback.
# This satellite delegates verification and must not receive the API signing secret.
# Choose your actual API host. In the production compose network this is http://api:3000.
ACCURA_API_URL=
# Positive integer milliseconds, at most 30000; omitted defaults to 10000.
ACCURA_API_TIMEOUT_MS=10000

# Rate limits, in requests per 15 minutes per client address. Every call the
# EDC proxies arrives from the EDC's own address. Leave both unset to keep the
# defaults. TRAINING_PUBLIC_RATE_LIMIT (default 200) is a TEST STACK setting:
# raise it only on a synthetic stack that drives many learners through the EDC
# proxy. The EDC's duty-readiness observations have their own bucket.
# Each must be an integer from 1 to 1000000; an invalid value refuses startup.
# TRAINING_PUBLIC_RATE_LIMIT=200
# TRAINING_DUTY_READINESS_RATE_LIMIT=6000

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info

# Training Configuration
CERTIFICATE_VALIDITY_DAYS=365
EXPIRATION_CHECK_CRON=0 2 * * *

# Training effort ledger (plan item T-4), off by default; only the exact value true turns it on. Then each
# graded quiz attempt, completion attestation and verification records one append-only effort interval in its
# decision's own transaction, and the machine route POST /api/training/effort-source/observe (through the EDC
# proxy, x-api-key) serves TrainingEffortSourceV1@1.0.0: hours by role and regimen arm and the lead time from
# an arm's EDC onboarding to trained staff. Unset, nothing is recorded and that route answers 503. The EDC
# forwards the observation path only with its own ENABLE_TRAINING_EFFORT=true. Leave unset in production.
# TRAINING_EFFORT_LEDGER_ENABLED=false
# TRAINING_DATA_CLASS=synthetic labels the observation synthetic: set it on a synthetic test stack only.
# Any other value, or none, reads not-stated.
# TRAINING_DATA_CLASS=
